{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "attacker": {
      "root": "client_side_xorigin/attacker",
      "framework": "express"
    },
    "victim": {
      "root": "client_side_xorigin/victim",
      "framework": "express"
    },
    "sql_injection": {
      "root": "sql_injection",
      "framework": "flask"
    },
    "xss-attacker": {
      "root": "xss/attacker",
      "framework": "express"
    },
    "bot": {
      "root": "xss/bot",
      "runtime": "container"
    },
    "xss-victim": {
      "root": "xss/victim",
      "framework": "express"
    }
  },
  "rewrites": [
  {
    "source": "/attacker/:path*",
    "destination": {
      "service": "attacker"
    }
  },
  {
    "source": "/sql/:path*",
    "destination": {
      "service": "sql_injection"
    }
  },
  {
    "source": "/xss/attacker/:path*",
    "destination": {
      "service": "xss-attacker"
    }
  },
  {
    "source": "/xss/victim/:path*",
    "destination": {
      "service": "xss-victim"
    }
  },
  {
    "source": "/:path*",
    "destination": {
      "service": "victim"
    }
  }
]
}
